{
  "name": "@simonwicre/dsh-session-view",
  "version": "1.0.0",
  "description": "A read-only session overview for DeepSeek Harness with workspace filters, live status and literal content search.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/SimonWicre/dsh-session-view.git" },
  "homepage": "https://github.com/SimonWicre/dsh-session-view#readme",
  "engines": { "dsh": "0.2.2-rc.2", "node": ">=24" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
